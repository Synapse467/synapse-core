PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://synapse:local-development-only@localhost:5434/synapse
REDIS_URL=redis://localhost:6381
AI_BASE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-random-local-service-token-at-least-32-characters
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=synapse-private
S3_ACCESS_KEY=synapse-local
S3_SECRET_KEY=synapse-local-development-only
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_SIGNER_SECRET=
STELLAR_CAPSULE_CONTRACT_ID=
STELLAR_LICENSE_CONTRACT_ID=
STELLAR_USAGE_CONTRACT_ID=
STELLAR_SETTLEMENT_CONTRACT_ID=
# Bootstrap first platform ADMIN(s). After first login the role is stored on User.platformRole.
PLATFORM_ADMIN_EMAILS=
# Optional extra bootstrap for REVIEWER (also persisted to User.platformRole).
PLATFORM_REVIEWER_EMAILS=
USAGE_BATCH_INTERVAL_MS=60000
SETTLEMENT_INTERVAL_MS=60000
# Optional real antivirus: e.g. "clamdscan --no-summary --stdout"
CLAMAV_CMD=
CLAMAV_REQUIRED=false
TRANSCRIPTION_RETENTION=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
